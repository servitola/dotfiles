<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TheBoringNotch fork (servitola/boring-notch, base TheBoredTeam/boring.notch): nightly
  upstream sync + rebuild + release + install through servitola/tap.

  A LaunchAgent, NOT a crontab entry — same rationale as alttab-sync: cron cannot exec
  files on /Volumes/SanDisk (EPERM) and cannot reach the login keychain for the Developer
  ID signing step. The TCC grant lives on helper/boring-notch-sync-runner.

  System Settings → Privacy & Security → Full Disk Access → + the runner binary.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.servitola.boring-notch-sync</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/servitola/projects/dotfiles/launchagents/helper/boring-notch-sync-runner</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>5</integer>
		<key>Minute</key>
		<integer>10</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>KeepAlive</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/Users/servitola/projects/dotfiles/cron/logs/boring-notch-sync.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/servitola/projects/dotfiles/cron/logs/boring-notch-sync.log</string>
</dict>
</plist>
