#!/usr/bin/env bash
# Create (or top up) a serho topic folder by hand, laid out the way the bot lays out
# the folders it creates itself (serho: core/handlers/forum_topic/_memory_files.py):
# AGENTS.md, CLAUDE.md and инструкция-для-бота.md pointing at it. AGENTS.md is seeded
# from $SERHO_PERSONA_FILE when set, else "# <name>"; an existing one is never touched.
#
# Usage:
#   new-topic <name>              # in ~/projects/serho_topics
#   new-topic <name> -r <root>    # another root
#   new-topic <name> --cd         # also print a cd line (eval "$(new-topic foo --cd)")

set -euo pipefail

if [[ $# -lt 1 ]]; then
    echo "usage: new-topic <name> [-r <root>] [--cd]" >&2
    exit 1
fi

name="$1"; shift
root="$HOME/projects/serho_topics"
print_cd=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        -r) root="$2"; shift 2 ;;
        --cd) print_cd=1; shift ;;
        *) echo "unknown arg: $1" >&2; exit 1 ;;
    esac
done

dir="$root/$name"
mkdir -p "$dir"

if [[ ! -s "$dir/AGENTS.md" ]]; then
    if [[ -n "${SERHO_PERSONA_FILE:-}" ]]; then
        cp "$SERHO_PERSONA_FILE" "$dir/AGENTS.md"
    else
        printf '# %s\n' "$name" > "$dir/AGENTS.md"
    fi
    echo "created  $dir/AGENTS.md"
fi

for alias in CLAUDE.md инструкция-для-бота.md; do
    if [[ ! -e "$dir/$alias" ]]; then
        ln -s AGENTS.md "$dir/$alias"
        echo "linked   $dir/$alias -> AGENTS.md"
    fi
done

echo "ready    $dir"

if (( print_cd )); then
    echo "cd $dir"
fi
