{
    "description": "Keyboard Lock Toggle (the four corners: bottom-left ⌃ or fn held, then top-left + ⌫ + → together)",
    "manipulators": [
        {
            "from": {
                "modifiers": {
                    "mandatory": [
                        "left_control"
                    ]
                },
                "simultaneous": [
                    {
                        "key_code": "grave_accent_and_tilde"
                    },
                    {
                        "key_code": "delete_or_backspace"
                    },
                    {
                        "key_code": "right_arrow"
                    }
                ],
                "simultaneous_options": {
                    "key_down_order": "insensitive"
                }
            },
            "parameters": {
                "basic.simultaneous_threshold_milliseconds": 200
            },
            "to": [
                {
                    "shell_command": "/opt/homebrew/bin/hs -c 'toggleKeyboardLock()'"
                }
            ],
            "type": "basic"
        },
        {
