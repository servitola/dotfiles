#!/bin/zsh
# rag — standalone wrapper around the `rag` shell function defined in
# $DIR_RAG/rag.sh, so that non-zsh callers (bash subshells used by Claude
# Code, Qwen Code, Codex, etc.) can invoke `rag` as a regular command.
#
# The function-based form is still preferred in interactive zsh (ai-like
# aliases, completion). This wrapper just forwards to it.

set -u
rag_sh="${DIR_RAG:-$HOME/projects/rag}/rag.sh"
if [[ ! -r $rag_sh ]]; then
  print -u2 "rag: not installed — clone servitola/rag to ${DIR_RAG:-$HOME/projects/rag}"
  exit 1
fi
source "$rag_sh"
rag "$@"
