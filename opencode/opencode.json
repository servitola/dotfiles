  "disabled_providers": [
    "opencode",
    "anthropic",
    "openai",
    "google",
    "openrouter",
    "github-copilot"
  ],
  "mcp": {
    "rag": {
      "type": "local",
      "command": ["/Users/servitola/projects/dotfiles/rag/mcp-server.py"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@0.0.78"],
      "enabled": true
    },
    "youtrack": {
      "type": "local",
      "command": ["/Users/servitola/.claude/scripts/youtrack-mcp-proxied.sh"],
      "enabled": true
    }
  },
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "allow",
      "sudo *": "ask",
      "rm -rf *": "deny",
      "rm -rf /*": "deny",
      "shutdown *": "deny",
      "reboot *": "deny",
      "diskutil erase*": "deny",
      "dd if=*": "ask",
      "mkfs*": "deny",
      "> /dev/*": "deny",
      "curl * | sh": "ask",
      "curl * | bash": "ask",
      "git push --force*": "ask",
      "git push -f*": "ask"
    }
  }
}
