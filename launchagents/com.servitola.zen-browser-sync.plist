<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Zen Browser: weekly rebuild from source + publish to servitola/tap + brew install.

  A LaunchAgent, NOT a crontab entry, since 2026-09-06. The checkout and the build tree
  live on /Volumes/SanDisk, which the system-context crontab cannot read at all: every
  Sunday the job logged "volume mounted but unreadable (TCC) — skip". The TCC grant
  lives on helper/zen-browser-sync-runner.

  Sunday 07:00, last in the nightly sequence (see zap-sync.plist). A cold Zen build is
  ~1 hour on every core and ~5 hours under background QoS on the efficiency cores.

  System Settings → Privacy & Security → Full Disk Access → + the runner binary.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.servitola.zen-browser-sync</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/servitola/projects/dotfiles/launchagents/helper/zen-browser-sync-runner</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Weekday</key>
		<integer>0</integer>
		<key>Hour</key>
		<integer>7</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>KeepAlive</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/Users/servitola/projects/dotfiles/cron/logs/zen-browser-sync.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/servitola/projects/dotfiles/cron/logs/zen-browser-sync.log</string>
</dict>
</plist>
