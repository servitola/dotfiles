<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  AltTab community fork (TroopJostle/alt-tab-community): daily upstream sync + rebuild +
  install over /Applications/AltTab.app.

  A LaunchAgent, NOT a crontab entry — same rationale as telegram-desktop-sync: cron cannot
  exec files on /Volumes/SanDisk (EPERM) and cannot reach the login keychain for the
  Developer ID signing step. The TCC grant lives on helper/alttab-sync-runner.

  System Settings → Privacy & Security → Full Disk Access → + the runner binary.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.servitola.alttab-sync</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/servitola/projects/dotfiles/launchagents/helper/alttab-sync-runner</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>5</integer>
		<key>Minute</key>
		<integer>50</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>KeepAlive</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/Users/servitola/projects/dotfiles/cron/logs/alttab-sync.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/servitola/projects/dotfiles/cron/logs/alttab-sync.log</string>
</dict>
</plist>
