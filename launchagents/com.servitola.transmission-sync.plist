<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Transmission fork (Liquid Glass macOS UI): upstream sync + rebuild, published
  to servitola/tap and installed with brew (since 2026-09-09; see the script).
  A LaunchAgent, NOT a crontab entry — same rationale as voiceink-upstream-sync:
  cron cannot exec files on /Volumes/SanDisk (EPERM) and cannot reach the login
  keychain for the Developer ID re-sign step. The TCC grant lives on
  helper/transmission-sync-runner.

  System Settings → Privacy & Security → Full Disk Access → + the runner binary.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.servitola.transmission-sync</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/servitola/projects/dotfiles/launchagents/helper/transmission-sync-runner</string>
	</array>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Weekday</key>
			<integer>1</integer>
			<key>Hour</key>
			<integer>3</integer>
			<key>Minute</key>
			<integer>30</integer>
		</dict>
		<dict>
			<key>Weekday</key>
			<integer>4</integer>
			<key>Hour</key>
			<integer>3</integer>
			<key>Minute</key>
			<integer>30</integer>
		</dict>
		<dict>
			<key>Weekday</key>
			<integer>6</integer>
			<key>Hour</key>
			<integer>3</integer>
			<key>Minute</key>
			<integer>30</integer>
		</dict>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>KeepAlive</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/Users/servitola/projects/dotfiles/cron/logs/transmission-sync.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/servitola/projects/dotfiles/cron/logs/transmission-sync.log</string>
</dict>
</plist>
