[include]
	path = "~/.local/state/dotfiles/generated/identity.gitconfig"
	path = "~/projects/dotfiles/git/aliases.gitconfig"
	path = "~/projects/dotfiles/git/colors.gitconfig"
	path = "~/projects/dotfiles/git/gitea.gitconfig"
	path = "~/projects/dotfiles/git/workname.gitconfig"
	path = "~/projects/dotfiles/git/github.gitconfig"

[branch]
	sort = -committerdate

[core]
	editor = code -w
	excludesfile = ~/projects/dotfiles/git/global_ignore

[credential]
  	helper = osxkeychain

[diff]
    renames = copies
    algorithm = histogram

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[pager]
    diff = "diff-so-fancy | less --tabs=4 -RFX"
    show = "diff-so-fancy | less --tabs=4 -RFX"

[init]
	defaultBranch = main

[gui]
	gcwarning = false

[pull]
  	rebase = true

[merge]
	conflictstyle = zdiff3

[push]
  	followTags = true
	autoSetupRemote = true

[fetch]
	prune = true

[commit]
	verbose = true

[rebase]
	autoStash = true
	updateRefs = true

[rerere]
	enabled = true

[help]
	autocorrect = prompt

[http]
	proxy =

[https]
	proxy =
