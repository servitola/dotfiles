<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <config>
    <add key="http_proxy" value="${PROXY_WORK_HTTP}" />
    <add key="https_proxy" value="${PROXY_WORK_HTTP}" />
    <add key="no_proxy" value="localhost,127.0.0.1,api.nuget.org,*.nuget.org,nuget.org" />
  </config>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

</configuration>
