<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  VoiceInk fork: daily upstream sync. A LaunchAgent, NOT a crontab entry.

  The sync ends in `make local-stable`, which signs the app with the self-signed
  "VoiceInk Local Signing" identity in the login keychain — an ad-hoc signature
  would change the cdhash and silently drop every TCC grant.

  macOS runs crontab jobs from a LaunchDaemon in the system context, with no user
  security session: the login keychain is not even in the search list, and
  `codesign --sign <sha1>` fails with "no identity found" (verified 2026-08-09).
  Pointing `security` at the keychain explicitly makes the certificate visible but
  still not the private key. There is no path/flag that fixes this from cron.

  A LaunchAgent runs inside the user's session, where the keychain is available and
  signing just works, with no password stored anywhere.

  The other half: a LaunchAgent cannot read /Volumes/SanDisk without a TCC grant
  ("ls: Operation not permitted", also verified 2026-08-09). That grant is given to
  helper/voiceink-sync-runner rather than to /bin/zsh, so it covers this one job
  instead of every zsh script on the machine. Children inherit the responsible-process
  attribution, so the script and everything it spawns are covered.

  System Settings → Privacy & Security → Full Disk Access → + the runner binary.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.servitola.voiceink-upstream-sync</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/servitola/projects/dotfiles/launchagents/helper/voiceink-sync-runner</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>4</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>KeepAlive</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/Users/servitola/projects/dotfiles/cron/logs/voiceink-upstream-sync.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/servitola/projects/dotfiles/cron/logs/voiceink-upstream-sync.log</string>
</dict>
</plist>
