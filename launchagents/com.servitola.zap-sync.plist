<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Zap (open-source Warp fork): upstream sync + rebuild + install.

  A LaunchAgent, NOT a crontab entry — same rationale as voiceink-upstream-sync and
  telegram-desktop-sync: the checkout may live on /Volumes/SanDisk (cron cannot exec
  build scripts from there, EPERM) and the install re-signs the bundle with the
  Developer ID key, which is only reachable from a user session. The TCC grant lives
  on helper/zap-sync-runner.

  02:00. Since 2026-09-09 every build runs under background QoS on the efficiency cores
  (~1.5 hours for Zap), so the starts are spread: telegram-desktop 00:10, zap 02:00,
  transmission 03:30, voiceink 04:30, boring-notch 05:10, opentracks 05:41, alttab
  05:50, telegram-android 06:20.

  Mondays, Thursdays and Saturdays, not every night (2026-09-22). Every fork sync
  shares that weekday set; Wednesday is excluded on purpose, so no build ever runs
  in the night from Tuesday to Wednesday. launchd cannot express "every N days",
  so the cadence is three fixed weekdays — gaps of 3, 2 and 2 days.

  System Settings → Privacy & Security → Full Disk Access → + the runner binary.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.servitola.zap-sync</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/servitola/projects/dotfiles/launchagents/helper/zap-sync-runner</string>
	</array>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Weekday</key>
			<integer>1</integer>
			<key>Hour</key>
			<integer>2</integer>
			<key>Minute</key>
			<integer>0</integer>
		</dict>
		<dict>
			<key>Weekday</key>
			<integer>4</integer>
			<key>Hour</key>
			<integer>2</integer>
			<key>Minute</key>
			<integer>0</integer>
		</dict>
		<dict>
			<key>Weekday</key>
			<integer>6</integer>
			<key>Hour</key>
			<integer>2</integer>
			<key>Minute</key>
			<integer>0</integer>
		</dict>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>KeepAlive</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/Users/servitola/projects/dotfiles/cron/logs/zap-sync.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/servitola/projects/dotfiles/cron/logs/zap-sync.log</string>
</dict>
</plist>
