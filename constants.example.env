# Generated from constants/schema.toml by constants/check.py — edit the schema, not this.
# Copy to constants.env (install.sh does it on a new Mac) and put this Mac's values there.

# account name, git author, GitHub handle
ME_NAME=servitola
# git author email
ME_EMAIL=you@example.com
# codesign identity that keeps re-signed tools trusted across upgrades: Developer ID Application: Name (TEAMID)
ME_SIGN_IDENTITY=NONE
# home timezone for schedules and digests
ME_TZ=Europe/London
# home city, local spelling
ME_CITY=London
# home city, English spelling
ME_CITY_ENG=London
# home country, ISO 3166-1 alpha-2
ME_COUNTRY=GB
# home address for deliveries and bookings
ME_ADDRESS=1 Example Street, London

# default browser
APP_BROWSER=Vivaldi
# bundle id of APP_BROWSER
APP_BROWSER_BUNDLE=com.vivaldi.Vivaldi
# second browser
APP_BROWSER_ALT=Google Chrome
# browser that work links are routed to
APP_BROWSER_WORK=Firefox
# main terminal
APP_TERMINAL=Zap
# bundle id of APP_TERMINAL
APP_TERMINAL_BUNDLE=dev.zap.Zap
# second terminal
APP_TERMINAL_ALT=iTerm
# Telegram client in use
APP_TELEGRAM=Telegram
# bundle id of APP_TELEGRAM
APP_TELEGRAM_BUNDLE=ru.keepcoder.Telegram
# text editor
APP_EDITOR=Visual Studio Code
# command that opens APP_EDITOR
APP_EDITOR_CLI=code
# git client
APP_GIT_GUI=Fork
# file manager
APP_FILES=Marta
# music player
APP_MUSIC=Music
# digital audio workstation
APP_DAW=Ableton Live 12 Suite
# video player
APP_VIDEO=IINA
# IDE
APP_IDE=Rider

# first input source, as macOS names it
LAYOUT_PRIMARY=ABC
# second input source
LAYOUT_SECONDARY=Russian – PC
# third input source
LAYOUT_TERTIARY=Greek

# side of the screen the Dock sits on: left, bottom or right
DOCK_POSITION=right
# yes or no: whether this Mac runs the docker stacks
DOCKER=yes

# root of every repository
DIR_PROJECTS=$HOME/projects
# this repository
DIR_DOTFILES=$HOME/projects/dotfiles
# employer repositories
DIR_WORK=$HOME/projects/work
# the employer repository worked in daily
DIR_WORK_MAIN=$HOME/projects/work/main
# the employer VPN container and the scripts that go through it
DIR_WORK_VPN=$HOME/projects/work-vpn
# docker compose services
DIR_SERVICES=$HOME/projects/services
# fork-sync jobs
DIR_FORKS=$HOME/projects/forks
# XDG config home
DIR_CONFIG=$HOME/.config
# external drive
DIR_EXTERNAL=/Volumes/SanDisk
# cron jobs repository (~/projects/cron)
DIR_CRON=$HOME/projects/cron
# cron fragments
DIR_CRON_JOBS=$HOME/projects/cron/cron_jobs
# scripts the cron fragments run
DIR_CRON_SCRIPTS=$HOME/projects/cron/scripts
# rag toolkit repository (~/projects/rag)
DIR_RAG=$HOME/projects/rag
# LiteLLM proxy and the TTS/STT shims (~/projects/services/litellm)
DIR_LITELLM=$HOME/projects/services/litellm
# Claude Code configuration
DIR_CLAUDE=$HOME/projects/dotfiles/claude-code
# Claude skills, detached skills and commands (~/projects/skills)
DIR_SKILLS=$HOME/projects/skills
# ssh alias of the machine that runs tart VMs
TART_HOST=tart-host

# comma-separated folders of other repositories whose commands go on PATH
DIRS_ON_PATH=NONE
# name in ~/Library/Logs that the cleanup leaves alone: a service that keeps its log open
DIRS_LOGS_KEEP=NONE
# comma-separated folders of other repositories whose *.plist are linked into ~/Library/LaunchAgents
DIRS_LAUNCHAGENTS=NONE

# API keys, sourced by shells and jobs
FILE_SECRETS=$HOME/.config/openai_key.sh
# env file of the notification bot
FILE_TG_BOT_ENV=$HOME/.config/notify-bot.env

# supergroup for reminders and digests
TG_CHAT_MAIN=-1000000000001
# supergroup for machine alerts
TG_CHAT_NOTIFY=-1000000000002
# supergroup of the third phone
TG_CHAT_PHONE3=-1000000000003
# comma-separated cwd substrings where deny-telegram-send refuses every send
TG_STRICT_DIRS=private-chat
# topic in TG_CHAT_NOTIFY for the weekly cron report
TG_THREAD_CRON=1486
# local Telegram Bot API server
TG_BOT_API=http://localhost:8081

# Bluetooth address of the Marshall speaker, as blueutil prints it
AUDIO_BT_MARSHALL=00-00-00-00-00-01
# Bluetooth address of the home speakers
AUDIO_BT_SPEAKERS=00-00-00-00-00-02

# local LiteLLM proxy
LITELLM_URL=http://localhost:4000
# local Qdrant
QDRANT_URL=http://localhost:6333
# the employer's YouTrack
WORK_YOUTRACK_URL=https://youtrack.example.com
# project new YouTrack tickets go to
WORK_YOUTRACK_PROJECT=PROJ
# the YouTrack the MCP server talks to
WORK_YOUTRACK_MCP_URL=https://youtrack.example.com
# the employer's GitLab
WORK_GITLAB_URL=https://gitlab.example.com
# deep link that opens the work app on Android
WORK_DEEPLINK_URL=https://app.example.com
# comma-separated URL substrings (Lua patterns) routed to the work browser
WORK_LINK_PATTERNS=work%.example

# employer VPN, SOCKS
PROXY_WORK=socks5://localhost:7070
# employer VPN, HTTP
PROXY_WORK_HTTP=http://127.0.0.1:7078
# tunnel through the Webdock server
PROXY_WEBDOCK=socks5://localhost:7072
# tunnel through the Jelly server
PROXY_JELLY=socks5://localhost:7073
# Blanc tunnel, Moscow exit
PROXY_BLANC_MOSCOW=socks5://localhost:7074
# Blanc tunnel, Los Angeles exit
PROXY_BLANC_LA=socks5://localhost:7075

# ssh alias of the home server
HOST_I9=home-server
# ssh alias of the mir5 machine
HOST_MIR5=other-mac
# ssh alias of the Gitea host
HOST_GITEA=gitea
# the self-hosted Gitea, origin of these repositories
GITEA_URL=https://gitea.example.com

# Claude model the scripts ask for
MODEL_CLAUDE_DEFAULT=claude-opus-5
# Codex model the scripts ask for
MODEL_CODEX_DEFAULT=gpt-5.6-terra
# default RAG collection
RAG_COLLECTION=dotfiles
