          }
        },
        "nvidia-deepseek": {
          "name": "NVIDIA DeepSeek V4 Pro (1M ctx)",
          "limit": {
            "context": 1000000,
            "output": 16384
          }
        },
        "mistral-large": {
          "name": "Mistral Large (direct, free tier)",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "mistral-medium": {
          "name": "Mistral Medium (direct, free tier — what Vibe CLI uses for tools)",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "mistral-codestral": {
          "name": "Mistral Codestral (direct, free tier)",
          "limit": {
            "context": 262144,
            "output": 8192
          }
        },
